FROM mcr.microsoft.com/dotnet/sdk:8.0.428 AS build
WORKDIR /source
COPY global.json Directory.Build.props ./
COPY src ./src
RUN dotnet publish src/Securities.Worker/Securities.Worker.csproj -c Release -o /app
FROM mcr.microsoft.com/dotnet/runtime:8.0
WORKDIR /app
COPY --from=build /app ./
USER app
ENTRYPOINT ["dotnet","Securities.Worker.dll"]
